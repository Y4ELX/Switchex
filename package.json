{
  "name": "switchex",
  "displayName": "Switchex",
  "description": "Switch between two local OpenAI Codex accounts in VS Code while keeping auth.json private.",
  "version": "0.1.2",
  "publisher": "Y4ELX",
  "icon": "image.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Y4ELX/Switchex.git"
  },
  "homepage": "https://github.com/Y4ELX/Switchex#readme",
  "bugs": {
    "url": "https://github.com/Y4ELX/Switchex/issues"
  },
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "openai codex",
    "codex accounts",
    "codex account switcher",
    "codex multiple accounts",
    "codex switch accounts",
    "switch codex account",
    "multiple codex accounts",
    "openai account switcher",
    "vscode codex"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codexAccountSwitcher.switchAccount1",
    "onCommand:codexAccountSwitcher.switchAccount2",
    "onCommand:codexAccountSwitcher.chooseAccount",
    "onCommand:codexAccountSwitcher.saveAccount1",
    "onCommand:codexAccountSwitcher.saveAccount2",
    "onCommand:codexAccountSwitcher.deleteAccount1",
    "onCommand:codexAccountSwitcher.deleteAccount2"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codexAccountSwitcher.switchAccount1",
        "title": "Switchex: Switch to Account 1"
      },
      {
        "command": "codexAccountSwitcher.switchAccount2",
        "title": "Switchex: Switch to Account 2"
      },
      {
        "command": "codexAccountSwitcher.chooseAccount",
        "title": "Switchex: Choose Account"
      },
      {
        "command": "codexAccountSwitcher.saveAccount1",
        "title": "Switchex: Save Current Login as Account 1"
      },
      {
        "command": "codexAccountSwitcher.saveAccount2",
        "title": "Switchex: Save Current Login as Account 2"
      },
      {
        "command": "codexAccountSwitcher.deleteAccount1",
        "title": "Switchex: Delete Account 1"
      },
      {
        "command": "codexAccountSwitcher.deleteAccount2",
        "title": "Switchex: Delete Account 2"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "codexAccountSwitcher.switchAccount1",
          "when": "false"
        },
        {
          "command": "codexAccountSwitcher.switchAccount2",
          "when": "false"
        },
        {
          "command": "codexAccountSwitcher.chooseAccount"
        },
        {
          "command": "codexAccountSwitcher.saveAccount1"
        },
        {
          "command": "codexAccountSwitcher.saveAccount2"
        },
        {
          "command": "codexAccountSwitcher.deleteAccount1",
          "when": "false"
        },
        {
          "command": "codexAccountSwitcher.deleteAccount2",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Switchex",
      "properties": {}
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "verify": "npm run lint && npm run compile && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.125.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
